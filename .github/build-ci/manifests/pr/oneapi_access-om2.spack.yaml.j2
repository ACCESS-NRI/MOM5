spack:
  include:
  # Include configuration from this repository, with the environment variable defined in build-ci
  - path: $SPACK_MANIFEST_REPOSITORY_PATH/.github/build-ci/config
  specs:
  - 'access-om2@latest %%access_oneapi'
  packages:
    mom5:
      require:
      - '@git.{{ ref }}=stable'
      - 'model=access-om2'
    cice5:
      require:
      - 'io_type=PIO build_system=cmake'
    oasis3-mct:
      require:
      - '@2025.03.001'
  view: false
